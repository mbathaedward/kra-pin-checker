cat > .gitignore << 'EOF'
# Python
__pycache__/
*.py[cod]
*.pyc
*.pyo
*.pyd
.Python

# Virtual Environment
venv/
.venv/
env/
.env/
checker/

# Environment variables — NEVER commit these
.env
*.env

# Django
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
media/
staticfiles/
static/

# Docker
postgres_data/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Migrations (optional — some teams commit these)
# */migrations/

# Coverage
.coverage
htmlcov/

# Distribution
dist/
build/
*.egg-info/
EOF